[Unit]
Description=Igor API server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
# Server req env where executable lives
Environment=IGOR_HOME=/home/igor
Type=simple
ExecStart=/opt/igor/igor-server
Restart=always
RestartSec=1
User=igor
TimeoutStopSec=60
# Makes SIGQUIT dump every goroutine rather than only the current one. Costs nothing at
# runtime and is the only way to identify what is holding the database write lock if the
# server ever stops responding to commands that write.
Environment=GOTRACEBACK=all

[Install]
WantedBy=multi-user.target